# ServiceNow
SERVICENOW_INSTANCE=your-instance.service-now.com
SERVICENOW_READ_TOKEN=your_read_token_here
SERVICENOW_WRITE_TOKEN=your_write_token_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Internal services
SYSTEM_SERVICE_TOKEN=your_service_token_here
HITL_QUEUE_URL=http://localhost:8001

# Optional — leave blank to skip
EVENT_BUS_URL=
SLACK_WEBHOOK_URL=

# Tunable (defaults shown)
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=10
CONFIDENCE_THRESHOLD=0.85
DEAD_LETTER_DB_PATH=dead_letter.db
DICTIONARIES_PATH=config/dictionaries.yaml
